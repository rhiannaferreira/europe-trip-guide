# Optional: turns on sign-in and saved trips (see README, "Accounts").
# Copy to .env.local for local work, and add the same two values in Vercel's Environment Variables.
# The anon key is public by design; never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
