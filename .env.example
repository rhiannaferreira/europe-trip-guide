# Optional: turns on sign-in and saved trips (see README, "Accounts").
# Copy to .env.local for local work, and add the same two values in Vercel's Environment Variables.
# The anon key is public by design; never put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: live data (see README, "Live places and trains"). Server-only: never prefix these with VITE_.
# Live places (Geoapify, free plan, no card): create a key at myprojects.geoapify.com.
GEOAPIFY_API_KEY=
# Live trains (Transitous): no key. On for previews; production needs LIVE_TRAINS=on (off turns it off anywhere).
LIVE_TRAINS=
# A contact Transitous can reach you at, sent in the User-Agent (an email address or a URL).
TRANSITOUS_CONTACT=
# Optional: one shared daily cap across server instances (run supabase/live.sql first).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: daily caps per provider (defaults: geoapify 2500, transitous 3000).
LIVE_DAILY_CAP_GEOAPIFY=
LIVE_DAILY_CAP_TRANSITOUS=
